{
  "description": "Preserve selected verbatim evidence around native Codex compaction. Opt in to TypeSafe network access with FAST_JEV_ALLOW_NETWORK=1.",
  "hooks": {
    "PreCompact": [{
      "matcher": "^(manual|auto)$",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "commandWindows": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "timeout": 25,
        "statusMessage": "Saving Jev-selected compaction evidence"
      }]
    }],
    "SessionStart": [{
      "matcher": "^compact$",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "commandWindows": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "timeout": 5,
        "additionalContextLimit": 4000,
        "statusMessage": "Restoring compaction evidence"
      }]
    }]
  }
}
