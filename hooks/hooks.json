{
  "description": "Save exact evidence around native Codex compaction. In configured Jev mode, rank task-relevant evidence before restoring the index; otherwise recover locally.",
  "hooks": {
    "PreCompact": [{
      "matcher": "^(manual|auto)$",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "commandWindows": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "timeout": 25,
        "statusMessage": "Saving evidence and selecting compaction recovery context"
      }]
    }],
    "SessionStart": [{
      "matcher": "^compact$",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "commandWindows": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "timeout": 5,
        "additionalContextLimit": 4000,
        "statusMessage": "Restoring selected evidence index"
      }]
    }]
  }
}
