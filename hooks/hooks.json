{
  "description": "Save exact local evidence and restore a small retrieval index around native Codex compaction. No network or API key required.",
  "hooks": {
    "PreCompact": [{
      "matcher": "^(manual|auto)$",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "commandWindows": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "timeout": 25,
        "statusMessage": "Saving local compaction evidence"
      }]
    }],
    "SessionStart": [{
      "matcher": "^compact$",
      "hooks": [{
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "commandWindows": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook",
        "timeout": 5,
        "additionalContextLimit": 4000,
        "statusMessage": "Restoring local evidence index"
      }]
    }]
  }
}
